    {
      "name": "A saved pair accepts the clash in either order and without case",
      "function": "isClashAccepted",
      "args": [
        "mb-1",
        "OB-1",
        [
          {
            "id": "MB-1|OB-1",
            "bookingAId": "MB-1",
            "bookingBId": "OB-1"
          }
        ]
      ],
      "expected": true
